{
  "name": "agent-os",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first desktop workspace for your AI team",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "test:core": "cargo test --manifest-path crates/agent-core/Cargo.toml",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.4.0"
  }
}
